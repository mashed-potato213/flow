{
  "name": "flow",
  "version": "1.1.0",
  "description": "个人记账应用 MVP - 基于 Cloudflare 全家桶",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "dev:all": "concurrently -k -n vite,worker -c blue,green \"npm:dev\" \"npm:dev:worker\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dev": "npm run build && wrangler deploy --env dev",
    "db:migrate:local": "wrangler d1 migrations apply flow-db-dev --local --env dev",
    "db:migrate:dev": "wrangler d1 migrations apply flow-db-dev --remote --env dev",
    "db:migrate:remote": "wrangler d1 migrations apply flow-db --remote",
    "db:create:dev": "wrangler d1 create flow-db-dev",
    "r2:create": "wrangler r2 bucket create flow-backups",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "记账",
    "PWA",
    "Cloudflare"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@types/node": "20.14.0",
    "@typescript-eslint/eslint-plugin": "8.0.0",
    "@typescript-eslint/parser": "8.0.0",
    "autoprefixer": "10.4.20",
    "concurrently": "8.2.2",
    "eslint": "8.57.0",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vite-plugin-pwa": "0.20.5",
    "workbox-window": "7.1.0",
    "wrangler": "4.140.0"
  },
  "dependencies": {
    "chart.js": "4.4.4",
    "dexie": "4.0.8",
    "sortablejs": "1.15.3",
    "ulid": "2.3.0",
    "zod": "3.23.8"
  }
}
