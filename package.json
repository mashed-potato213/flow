{
  "name": "flow",
  "version": "1.0.0",
  "description": "个人记账应用 MVP - 基于 Cloudflare 全家桶",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply flow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flow-db --remote",
    "db:create": "wrangler d1 create flow-db",
    "r2:create": "wrangler r2 bucket create flow-backups"
  },
  "keywords": [
    "记账",
    "PWA",
    "Cloudflare"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "autoprefixer": "^10.6.0",
    "dexie": "^4.4.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "ulid": "^3.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "sortablejs": "^1.15.7"
  }
}
